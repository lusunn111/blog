---
import { getBlogCollection } from 'astro-pure/server'
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import { getSeriesGroups, seriesHref } from '@/utils/taxonomy'

const groups = getSeriesGroups(await getBlogCollection())
const meta = {
  title: '系列',
  description: '按照文章之间的先后关系，连续阅读一个问题。'
}
---

<PageLayout {meta}>
  <Button title='返回首页' href='/' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-3 text-3xl font-medium'>系列</h1>
      <p class='text-muted-foreground'>系列用于组织围绕同一问题持续推进、具有阅读顺序的文章。</p>
    </div>

    <section id='content' class='animate mt-8' aria-label='文章系列'>
      {
        groups.length > 0 ? (
          <ul class='grid gap-4 sm:grid-cols-2'>
            {groups.map(([name, posts]) => (
              <li>
                <a
                  class='block rounded-2xl border bg-background p-6 transition-colors hover:bg-muted'
                  href={seriesHref(name)}
                >
                  <div class='flex items-center justify-between gap-4'>
                    <h2 class='text-lg font-medium'>{name}</h2>
                    <span class='text-sm text-muted-foreground'>{posts.length} 篇</span>
                  </div>
                  <p class='mt-3 line-clamp-2 text-sm text-muted-foreground'>
                    {posts[0]?.data.description}
                  </p>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <div class='rounded-2xl border bg-muted p-6'>
            <p class='font-medium'>系列文章正在准备中。</p>
            <p class='mt-2 text-sm text-muted-foreground'>
              在文章头部填写 series 和 seriesOrder 后，这里会自动生成系列入口与阅读顺序。
            </p>
          </div>
        )
      }
    </section>
  </main>
</PageLayout>
