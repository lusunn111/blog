---
import { Image } from 'astro:assets'

import { PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button, Icon, Label } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import Section from '@/components/home/Section.astro'
import { CATEGORIES, categoryHref } from '@/utils/taxonomy'
import avatar from '@/assets/avatar.jpg'
import config from '@/site-config'

const allPosts = sortMDByDate(await getBlogCollection())
const latestPosts = allPosts.slice(0, 8)
---

<PageLayout meta={{ title: '首页', description: config.description }} highlightColor='#3f748f'>
  <main class='flex w-full flex-col items-center'>
    <section class='animate mb-12 flex flex-col items-center gap-y-6' id='content-header'>
      <Image
        src={avatar}
        alt='毛郅皓的照片'
        class='h-28 w-28 rounded-full border object-cover p-1'
        loading='eager'
        fetchpriority='high'
      />

      <div class='flex flex-col items-center gap-y-3 text-center'>
        <h1 class='text-3xl font-medium'>{config.title}</h1>
        <p class='max-w-2xl text-muted-foreground'>{config.description}</p>
        <p class='max-w-2xl text-sm leading-6 text-muted-foreground'>
          中国地质大学（武汉）本科在读 · 北京大学 IF-Lab 研究实习生 · 2027
          年秋季入学北京大学计算机学院博士项目
        </p>
        <div class='mt-2 flex flex-wrap justify-center gap-x-6 gap-y-3'>
          <Label title='北京'>
            <Icon name='location' class='size-5' slot='icon' />
          </Label>
          <Label title='个人学术主页' as='a' href='https://lusunn111.github.io/' target='_blank'>
            <Icon name='earth' class='size-5' slot='icon' />
          </Label>
          <Label
            title='Google Scholar'
            as='a'
            href='https://scholar.google.com/citations?user=lQmlVzoAAAAJ&hl=zh-CN'
            target='_blank'
          >
            <Icon name='document' class='size-5' slot='icon' />
          </Label>
          <Label title='GitHub' as='a' href='https://github.com/lusunn111' target='_blank'>
            <Icon name='github' class='size-5' slot='icon' />
          </Label>
          <Label title='邮件' as='a' href='mailto:htxmzh@gmail.com'>
            <Icon name='email' class='size-5' slot='icon' />
          </Label>
        </div>
      </div>
    </section>

    <div id='content' class='animate flex flex-col gap-y-12 md:w-4/5 lg:w-5/6'>
      <Section title='写在这里'>
        <p class='text-muted-foreground'>
          我把这里当作一份可以长期检索的研究日志。技术文章记录论文阅读、系统设计、实验失败与工程实现；“读博日记”从入学前的准备开始，留下选择、见闻以及研究之外的生活。
        </p>
      </Section>

      <Section title='分类'>
        <div class='grid grid-cols-1 gap-3 sm:grid-cols-2'>
          {
            CATEGORIES.map((category) => {
              const count = allPosts.filter((post) => post.data.category === category).length
              const description =
                category === '技术'
                  ? '具身智能系统，VLA、VLN 与 WAM 的推理优化和工程实践'
                  : '入学准备、科研过程、实验复盘、阶段选择与日常生活'

              return (
                <a
                  class='rounded-2xl border bg-background p-5 transition-colors hover:bg-muted'
                  href={categoryHref(category)}
                >
                  <div class='flex items-center justify-between gap-4'>
                    <h2 class='text-lg font-medium'>{category}</h2>
                    <span class='text-sm text-muted-foreground'>{count} 篇</span>
                  </div>
                  <p class='mt-2 text-sm text-muted-foreground'>{description}</p>
                </a>
              )
            })
          }
        </div>
      </Section>

      {
        latestPosts.length > 0 && (
          <Section title='最近文章'>
            <ul class='flex flex-col gap-y-2'>
              {latestPosts.map((post) => (
                <PostPreview post={post} />
              ))}
            </ul>
            <Button title='查看全部文章' class='w-fit self-end' href='/blog' variant='ahead' />
          </Section>
        )
      }
    </div>
  </main>
</PageLayout>
